NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres runs in docker, exposed on host port 5433
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=docintel
DATABASE_PASSWORD=docintel
DATABASE_NAME=docintel

# Redis runs in docker, exposed on host port 6380
REDIS_HOST=localhost
REDIS_PORT=6380

# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# Free key from https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=

# Where uploaded files are kept. The API and worker must both reach this folder.
STORAGE_DIR=uploads

# Optional, for "Continue with Google". This is a client ID, not a secret.
GOOGLE_CLIENT_ID=

# gemini needs GEMINI_API_KEY. fake is free and offline, for tests and trying things out.
AI_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# How close a passage must be to a question to count as relevant.
SEARCH_MAX_DISTANCE=0.4
