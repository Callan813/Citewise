# Copy to .env.production on the server and fill it in. Never commit the copy.
# Generate secrets with:  openssl rand -base64 48

# Your domain, such as citewise.example.com. Use :80 to test without HTTPS.
SITE_ADDRESS=citewise.example.com

DATABASE_USER=citewise
DATABASE_NAME=citewise
DATABASE_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Keeps the shared Gemini quota safe from one busy user or many small accounts.
DAILY_QUESTION_LIMIT=30
DAILY_QUESTION_LIMIT_GLOBAL=300

# Optional: an account interviewers can try, created by the seed script.
DEMO_EMAIL=
DEMO_PASSWORD=

# Needed for the optional monitoring profile.
METRICS_TOKEN=
GRAFANA_PASSWORD=change-me
